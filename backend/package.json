{
  "name": "pykes-backend",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "dotenv -e .env.local -- node --watch src/index.js",
    "start": "node src/index.js",
    "migrate:create": "node-pg-migrate create",
    "migrate:up": "dotenv -e .env.local -- node-pg-migrate up",
    "migrate:down": "dotenv -e .env.local -- node-pg-migrate down"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.12.0",
    "redis": "^4.7.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "dotenv-cli": "^7.4.2"
  }
}
