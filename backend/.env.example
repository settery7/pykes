PORT=4000
DATABASE_URL=postgres://pykes:pykes@postgres:5432/pykes
REDIS_URL=redis://redis:6379
JWT_SECRET=change-this-to-something-long-and-random
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=pykesadmin
S3_SECRET_KEY=pykessecret
S3_BUCKET=pykes-media

# Production (e.g. Cloudflare R2) uses the same S3_* variables above, just
# pointed elsewhere, plus these two extras — see docker-compose.yml's `minio`
# service comment and backend/src/db/s3.js for why they're needed:
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_PUBLIC_URL=https://<your-r2-public-or-custom-domain>

# Resend (https://resend.com) — free tier: 3,000 emails/month, 100/day.
# Used for account email-verification links and the follower-digest
# notification. Leave RESEND_API_KEY unset for local dev — backend/src/
# email.js logs the would-be email to the console instead of sending.
# Without a verified custom domain on Resend, EMAIL_FROM must stay their
# sandbox address below.
# RESEND_API_KEY=re_...
# EMAIL_FROM=onboarding@resend.dev

# Shared secret for the /api/internal/* routes, called by a scheduled
# Make/Zapier scenario rather than a logged-in user (see README's
# "Follower digest automation" section). Generate any long random string
# and put the same value in the Make/Zapier webhook's headers.
# INTERNAL_SECRET=

